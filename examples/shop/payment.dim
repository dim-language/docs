dim "0.6";

// A third-party payment gateway. Imported by main.dim.
// An external system holds only its API contract: endpoints and data types.

system payment "Payment Gateway" {
  description "A third-party gateway for cards and e-wallets.";
  external;

  container gateway "Gateway API" {
    role service;

    component charges "Charges" {
      description "The gateway's public API for charges and refunds.";

      record chargeRequest "ChargeRequest" {
        description "A request to charge one payment.";
        field reference: uuid "The caller's order id, used as an idempotency key";
        field amount: decimal;
      }

      record chargeResult "ChargeResult" {
        description "A successful charge.";
        field chargeId: string;
      }

      record refundRequest "RefundRequest" {
        description "A request to refund one charge.";
        field chargeId: string;
      }

      record refundResult "RefundResult" {
        description "A refund the gateway accepted.";
        field refundId: string;
      }

      record declined "Declined" {
        description "The gateway declined the request.";
        field reason: string;
      }

      endpoint charge "Charge" {
        description "Charges one payment.";
        http post "/charges";
        body chargeRequest;
        returns 201 chargeResult;
        throws 402 declined "The card or e-wallet declined the charge";
      }

      endpoint refund "Refund" {
        description "Refunds one charge.";
        http post "/refunds";
        body refundRequest;
        returns 201 refundResult;
        throws 409 declined "The charge was already refunded";
      }
    }
  }
}
