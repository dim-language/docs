// Model lengkap toko online, dipecah ke beberapa file (dim v0.3).
// Jalankan: dim check examples/shop/main.dim

import "shop.dim";
import "payment.dim";

person customer "Customer" {
  description "Belanja online";
}

checkout_click: customer -> shop.web.checkout.button "Klik bayar";
charge_gateway: shop.api.payments.client.charge -> payment.gateway "POST /charges" {
  op call;
  tech "HTTPS";
  data push "ChargeRequest";
  data pull "ChargeResult";
}

open_detail: customer -> shop.web.detail "Buka detail pesanan";
request_refund: customer -> shop.web.detail "Ajukan refund";
refund_gateway: shop.api.orders.refund -> payment.gateway "POST /refunds" {
  op call;
  tech "HTTPS";
  data push "RefundRequest";
  data pull "RefundId";
}

// Tim ops menambah keterangan tanpa mengubah shop.dim.
extend shop.db {
  description "Satu instance primer dengan satu replika baca.";
  tags "ops";
}

flow checkout "Checkout" {
  description "Dari pembeli menekan bayar sampai order tersimpan.";
  step checkout_click;
  step checkout_post;
  step run_checkout;
  step charge "Tagih dulu";
  step charge_gateway;
  step save_order "Simpan setelah tertagih";
  step insert_order;
}

flow order_detail "Detail pesanan" {
  description "Pembeli membuka pesanan yang sudah dibuat untuk melihat rincian barang dan totalnya.";
  step open_detail "Pembeli memilih pesanan";
  step detail_get "Web meminta rincian untuk ID yang dipilih";
  step find_order "API mencari pesanan lewat repository";
  step select_order "Repository membaca pesanan dari Postgres untuk ditampilkan di Web";
}

flow refund "Refund" {
  description "Pembeli mengajukan pengembalian dana untuk pesanan yang sudah dibayar.";
  step request_refund "Pembeli menekan tombol refund di detail pesanan";
  step refund_post "Web mengirim ID pesanan ke API";
  step refund_gateway "Gateway memproses permintaan dan mengembalikan ID refund";
  step record_refund "API mencatat ID refund pada pesanan di Postgres";
}
