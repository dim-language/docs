dim "0.6";

// The complete online shop model, split across several files.
// Check it with: dim check examples/shop/main.dim

import "payment.dim";
import "shop.dim";

person customer "Customer" { description "Shops online."; }

// The ops team adds details without changing shop.dim.
extend shop.db { description "One primary instance with one read replica."; tags ops; }

clickPay: customer -> shop.web.checkout.button "Click pay" { op use; }

chargeGateway: shop.api.payments.client.charge -> payment.gateway.charges.charge {
  op call;
  tech https;
}

openDetail: customer -> shop.web.detail "Open order details" { op use; }
requestRefund: customer -> shop.web.detail "Request a refund" { op use; }
refundGateway: shop.api.orders.refund -> payment.gateway.charges.refund { op call; tech https; }

flow checkout "Checkout" {
  description "From the shopper clicking pay to the order being saved.";
  step clickPay;
  step postCheckout;
  step runCheckout;
  step computeTotal;
  step charge "Charge first";
  step chargeGateway;
  alt {
    case paid "Payment succeeded" { step saveOrder "Save once charged"; step insertOrder; }
    case declined "Payment declined" { step showDeclined; }
  }
}

flow orderDetail "Order details" {
  description "The shopper opens a placed order to see its items and total.";
  step openDetail "The shopper picks an order";
  step getDetail "The web app asks for the chosen id's details";
  step findOrder "The API looks up the order through the repository";
  step selectOrder "The repository reads the order from Postgres";
}

flow refund "Refund" {
  description "The shopper asks for a refund on a paid order.";
  step requestRefund "The shopper presses refund in the order details";
  step postRefund "The web app sends the order id to the API";
  step refundGateway "The gateway processes the request and returns a refund number";
  step recordRefund "The API records the refund number on the order in Postgres";
}

environment production "Production" {
  description "One AWS region, with a managed database.";

  node aws "AWS Jakarta" {
    tech aws;

    infra cdn "CloudFront" { role cdn; tech cloudfront; }

    node cluster "EKS" {
      tech kubernetes;
      deploy webPods shop.web { replicas 2; }
      deploy apiPods shop.api { replicas 3; }
    }

    node rds "RDS" {
      tech postgres;
      deploy primary shop.db { replicas 1; }
    }

    node legacy "Reports VM" {
      deploy reportsVm shop.reports { replicas 1; }
    }
  }

  serveWeb: aws.cdn -> aws.cluster.webPods { op use; }
}
