dim "0.6";

tech nextjs "Next.js";
tech rust "Rust";
tech axum "axum" { version "0.7"; }
tech axum08 "axum" { version "0.8"; }
tech postgres "PostgreSQL" { version "16"; }
tech php "PHP";
tech clickhouse "ClickHouse";
tech sqs "Amazon SQS";
tech https "HTTPS";
tech aws "AWS";
tech cloudfront "CloudFront";
tech kubernetes "Kubernetes";

tag ops "Maintained by the ops team";

style role app { icon browser; background blue; }
style role service { icon server; background accent; }
style role database { icon database; background neutral; }
style role queue { icon queue; background purple; }
style tag ops { background info; }
