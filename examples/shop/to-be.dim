dim "0.6";
amends "main.dim";

// The planned architecture: analytics replaces the old report, and every checkout is sent as an event.
// This file derives from main.dim; main.dim can still be used on its own.

extend shop {
  container analytics "Analytics" {
    description "Replaces the nightly report; data arrives through events, not Postgres queries.";
    role database;
    tech clickhouse;
  }

  container events "Checkout Events" {
    description "A queue of checkout events for analytics.";
    role queue;
    tech sqs;
  }
}

extend shop.api {
  tech rust axum08;

  component audit "Audit Log" {
    description "Records every checkout for reconciliation with the payment gateway.";

    record checkoutEvent "CheckoutEvent" {
      description "One completed checkout.";
      field orderId: orders.orderId;
      field total: orders.money;
    }

    endpoint checkoutCompleted "Checkout completed" {
      description "Sent after an order is saved.";
      event "CheckoutCompleted" on ::shop.events;
      payload checkoutEvent;
    }
  }
}

extend production.aws {
  node managed "Managed services" {
    deploy analyticsDb shop.analytics { replicas 1; }
    deploy eventsQueue shop.events { replicas 1; }
  }
}

announceCheckout: shop.api.checkout.service.run -> shop.api.audit.checkoutCompleted { op publish; }
ingestCheckout: shop.analytics -> shop.api.audit.checkoutCompleted { op subscribe; }

remove shop.reports;
