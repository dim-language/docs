dim "0.6";
amends "main.dim";

// Rencana arsitektur: laporan lama diganti analytics, dan setiap checkout dikirim sebagai event.
// File ini turunan dari main.dim; main.dim tetap bisa dipakai sendiri.

extend shop {
  container analytics "Analytics" {
    description "Menggantikan laporan harian; data masuk lewat event, bukan query ke Postgres.";
    role database;
    tech clickhouse;
  }

  container events "Checkout Events" {
    description "Antrian event checkout untuk analytics.";
    role queue;
    tech sqs;
  }
}

extend shop.api {
  tech rust axum08;

  component audit "Audit Log" {
    description "Mencatat setiap checkout untuk rekonsiliasi dengan payment gateway.";

    record checkoutEvent "CheckoutEvent" {
      description "Satu checkout yang sudah selesai.";
      field orderId: orders.orderId;
      field total: orders.money;
    }

    endpoint checkoutCompleted "Checkout selesai" {
      description "Dikirim setelah order tersimpan.";
      event "CheckoutCompleted" on ::shop.events;
      payload checkoutEvent;
    }
  }
}

extend production.aws {
  node managed "Layanan terkelola" {
    deploy analyticsDb shop.analytics { replicas 1; }
    deploy eventsQueue shop.events { replicas 1; }
  }
}

announceCheckout: shop.api.checkout.service.run -> shop.api.audit.checkoutCompleted { op publish; }
ingestCheckout: shop.analytics -> shop.api.audit.checkoutCompleted { op subscribe; }

remove shop.reports;
