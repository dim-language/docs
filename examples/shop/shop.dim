dim "0.6";

// Sistem toko online: container, komponen, dan level kode.
// Di-import oleh main.dim; relasi ke sistem lain ditulis di sana.

system shop "Online Shop" {
  container web "Web App" {
    role app;
    paradigm functional;
    tech nextjs;

    component detail "Detail Pesanan" {
      description "Menampilkan pesanan dan menerima permintaan refund dari pembeli.";
    }

    component checkout "Checkout Page" {
      description "Ringkasan keranjang, tombol bayar, dan pesan saat penagihan ditolak.";

      function button "CheckoutButton.onClick()" {
        description "Mengirim isi keranjang ke API saat pembeli menekan tombol bayar.";
        async;
        effects;
      }

      function notice "showPaymentError()" {
        description "Menampilkan alasan penagihan ditolak dan mengajak pembeli mencoba metode lain.";
        effects;
      }
    }
  }

  container api "API" {
    description """
      Backend utama.
      Menangani checkout dan order.
      """;
    role service;
    paradigm procedural oop;
    tech rust axum;

    component checkout "Checkout" {
      description "Menerima checkout dari web dan menjalankannya sampai order tersimpan.";

      endpoint post "Checkout" {
        description "Menerima keranjang dari web dan mengembalikan id order baru.";
        http post "/checkout";
        handler route;
        body orders.cart;
        returns 201 orders.orderId;
        throws 402 payments.paymentError "Penagihan ditolak gateway";
      }

      function route "post_checkout()" {
        description "Handler HTTP POST /checkout: membaca body JSON lalu menjalankan CheckoutService.";
        async;
        param cart: orders.cart;
        returns orders.orderId;
        throws payments.paymentError;
      }

      class service "CheckoutService" {
        description "Menjalankan checkout: menghitung total, menagih pembayaran, lalu menyimpan order.";
        field store: orders.store;
        field payments: payments.client;

        constructor create "new()" {
          description "Membuat service dengan penyimpanan order dan klien pembayaran.";
          param store: orders.store;
          param payments: payments.client;
        }

        method run "checkout()" {
          description "Satu checkout dari keranjang sampai order tersimpan. Order tidak disimpan kalau penagihan gagal.";
          async;
          param cart: orders.cart "Isi keranjang dan alamat pengiriman";
          returns orders.orderId "Id order yang baru dibuat";
          throws payments.paymentError "Penagihan ditolak gateway";
        }

        method total "total_price()" {
          description "Menjumlahkan harga item; bundel dihitung dengan menjumlahkan item di dalamnya.";
          visibility private;
          param items: orders.item[];
          returns orders.money;
        }
      }
    }

    component payments "Payments" {
      description "Menagih dan me-refund pembayaran lewat payment gateway.";

      alias chargeId "ChargeId" { description "Id penagihan dari gateway."; type string; }

      record paymentError "PaymentError" {
        description "Penagihan gagal: ditolak gateway, atau gateway tidak merespons.";
        field reason: string;
        field retryable: bool;
      }

      class client "PaymentClient" {
        description "Klien HTTP ke payment gateway: menandatangani request dan mengulang saat timeout.";
        field baseUrl: url;

        method charge "charge()" {
          description "Menagih satu pembayaran. Aman diulang karena memakai id order sebagai idempotency key.";
          async;
          param order: orders.orderId;
          param amount: orders.money;
          returns chargeId;
          throws paymentError "Ditolak, atau gateway tidak merespons";
        }
      }
    }

    component orders "Orders" {
      description "Menyimpan, mencari, dan me-refund order.";

      alias orderId "OrderId" { description "Id order, dibuat saat checkout."; type uuid; }

      alias refundId "RefundId" { description "Nomor refund dari payment gateway."; type string; }

      alias money "Money" { description "Jumlah uang dalam rupiah."; type decimal; }

      record item "Item" {
        description "Satu barang di keranjang atau order.";
        field productId: uuid;
        field quantity: int;
        field price: money;
        field bundle: item[] "Isi bundel; kosong untuk barang biasa";
      }

      record cart "Cart" {
        description "Isi keranjang yang akan dibayar.";
        field items: item[];
        field shippingAddress: string;
      }

      record order "Order" {
        description "Order yang sudah dibayar dan menunggu dikirim.";
        field id: orderId;
        field items: item[];
        field total: money;
      }

      record orderMissing "OrderMissing" {
        description "Tidak ada order dengan id itu.";
        field id: orderId;
      }

      record dbError "DbError" { description "Gagal menulis ke database."; field reason: string; }

      endpoint getOrder "Detail order" {
        description "Mengambil rincian order untuk halaman detail.";
        http get "/orders/{id}";
        handler detail;
        param id: orderId;
        returns 200 order;
        throws 404 orderMissing;
      }

      endpoint refundOrder "Refund order" {
        description "Mengajukan refund untuk order yang sudah dibayar.";
        http post "/orders/{id}/refund";
        handler refund;
        param id: orderId;
        returns 201 refundId;
        throws 404 orderMissing;
        throws 402 payments.paymentError "Gateway menolak refund";
      }

      function detail "get_order()" {
        description "Mencari order untuk halaman detail.";
        async;
        param id: orderId;
        returns order?;
      }

      function refund "refund_order()" {
        description "Meminta refund ke gateway dan mencatat nomor refund setelah gateway mengonfirmasi.";
        async;
        param id: orderId;
        returns refundId;
        throws payments.paymentError;
      }

      interface store "OrderStore" {
        description "Kontrak penyimpanan order, supaya CheckoutService tidak bergantung langsung ke Postgres.";

        method save "save()" {
          description "Menyimpan order baru.";
          async;
          param value: order;
          throws dbError;
        }
      }

      class rows "OrderRepository" {
        description "Implementasi OrderStore di atas Postgres. Semua penulisan memakai satu transaksi per order.";

        method find "find_by_id()" {
          description "Mengambil satu order beserta item-itemnya.";
          async;
          param id: orderId;
          returns order? "Kosong kalau order tidak ada";
        }

        method save "save()" {
          description "Menyimpan order baru dalam satu transaksi.";
          async;
          param value: order;
          throws dbError "Gagal menulis ke database";
        }
      }
    }
  }

  container db "Postgres" { role database; tech postgres; }

  container reports "Laporan Harian" {
    description "Skrip lama yang membaca order langsung dari database setiap malam.";
    role service;
    tech php;
  }

  // Relasi di dalam blok `shop` memakai path relatif terhadap `shop`.
  postCheckout: web.checkout.button -> api.checkout.post { op call; tech https; }
  showDeclined: web.checkout.button -> web.checkout.notice "Tampilkan alasan penolakan" { op call; }

  runCheckout: api.checkout.route -> api.checkout.service.run "Jalankan checkout" {
    op call;
    data push api.orders.cart;
    data pull api.orders.orderId;
  }

  computeTotal: api.checkout.service.run -> api.checkout.service.total "Hitung total" {
    op call;
    data pull api.orders.money;
  }

  sumBundle: api.checkout.service.total -> api.checkout.service.total "Isi bundel" { op call; }

  charge: api.checkout.service.run -> api.payments.client.charge "Tagih" {
    op call;
    data push api.orders.money;
    data pull api.payments.chargeId;
  }

  saveOrder: api.checkout.service.run -> api.orders.store.save "Simpan order" {
    op call;
    data push api.orders.order;
  }

  insertOrder: api.orders.rows.save -> db "INSERT orders" { op write; data push api.orders.order; }
  getDetail: web.detail -> api.orders.getOrder { op call; tech https; }

  findOrder: api.orders.detail -> api.orders.rows.find "Cari berdasarkan id" {
    op call;
    data push api.orders.orderId;
    data pull api.orders.order;
  }

  selectOrder: api.orders.rows.find -> db "SELECT orders" { op read; data pull api.orders.order; }
  postRefund: web.detail -> api.orders.refundOrder { op call; tech https; }
  recordRefund: api.orders.refund -> db "UPDATE orders" { op write; data push api.orders.refundId; }
  nightlyReport: reports -> db "SELECT orders" { op read; data pull api.orders.order; }

  // Struktur kelas.
  repoContract: api.orders.rows -> api.orders.store { op implements; }
  serviceStore: api.checkout.service -> api.orders.store { op refers; }
  serviceClient: api.checkout.service -> api.payments.client { op refers; }
}
