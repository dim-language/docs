dim "0.6";

// The online shop system: containers, components, and the code level.
// Imported by main.dim; relations to other systems are written there.

system shop "Online Shop" {
  container web "Web App" {
    role app;
    paradigm functional;
    tech nextjs;

    component detail "Order Details" {
      description "Shows an order and takes refund requests from the shopper.";
    }

    component checkout "Checkout Page" {
      description "The cart summary, the pay button, and the message when a charge is declined.";

      function button "CheckoutButton.onClick()" {
        description "Sends the cart to the API when the shopper presses pay.";
        async;
        effects;
      }

      function notice "showPaymentError()" {
        description "Shows why a charge was declined and invites the shopper to try another method.";
        effects;
      }
    }
  }

  container api "API" {
    description """
      The main backend.
      Handles checkout and orders.
      """;
    role service;
    paradigm procedural oop;
    tech rust axum;

    component checkout "Checkout" {
      description "Takes a checkout from the web app and runs it until the order is saved.";

      endpoint post "Checkout" {
        description "Takes a cart from the web app and returns the new order's id.";
        http post "/checkout";
        handler route;
        body orders.cart;
        returns 201 orders.orderId;
        throws 402 payments.paymentError "The gateway declined the charge";
      }

      function route "post_checkout()" {
        description "The HTTP POST /checkout handler: reads the JSON body, then runs CheckoutService.";
        async;
        param cart: orders.cart;
        returns orders.orderId;
        throws payments.paymentError;
      }

      class service "CheckoutService" {
        description "Runs a checkout: totals the cart, charges the payment, then saves the order.";
        field store: orders.store;
        field payments: payments.client;

        constructor create "new()" {
          description "Creates the service with an order store and a payment client.";
          param store: orders.store;
          param payments: payments.client;
        }

        method run "checkout()" {
          description "One checkout from cart to saved order. The order isn't saved if the charge fails.";
          async;
          param cart: orders.cart "The cart contents and shipping address";
          returns orders.orderId "The id of the new order";
          throws payments.paymentError "The gateway declined the charge";
        }

        method total "total_price()" {
          description "Adds up item prices; a bundle is priced by adding up the items inside it.";
          visibility private;
          param items: orders.item[];
          returns orders.money;
        }
      }
    }

    component payments "Payments" {
      description "Charges and refunds payments through the payment gateway.";

      alias chargeId "ChargeId" { description "A charge id from the gateway."; type string; }

      record paymentError "PaymentError" {
        description "A failed charge: the gateway declined it or didn't respond.";
        field reason: string;
        field retryable: bool;
      }

      class client "PaymentClient" {
        description "An HTTP client for the payment gateway: signs requests and retries on timeouts.";
        field baseUrl: url;

        method charge "charge()" {
          description "Charges one payment. Safe to retry because it uses the order id as an idempotency key.";
          async;
          param order: orders.orderId;
          param amount: orders.money;
          returns chargeId;
          throws paymentError "Declined, or the gateway didn't respond";
        }
      }
    }

    component orders "Orders" {
      description "Saves, looks up, and refunds orders.";

      alias orderId "OrderId" { description "An order id, created at checkout."; type uuid; }

      alias refundId "RefundId" {
        description "A refund number from the payment gateway.";
        type string;
      }

      alias money "Money" { description "An amount of money in rupiah."; type decimal; }

      record item "Item" {
        description "One item in a cart or order.";
        field productId: uuid;
        field quantity: int;
        field price: money;
        field bundle: item[] "The bundle's contents; empty for a single item";
      }

      record cart "Cart" {
        description "The cart about to be paid for.";
        field items: item[];
        field shippingAddress: string;
      }

      record order "Order" {
        description "An order that's paid and waiting to ship.";
        field id: orderId;
        field items: item[];
        field total: money;
      }

      record orderMissing "OrderMissing" {
        description "There's no order with that id.";
        field id: orderId;
      }

      record dbError "DbError" {
        description "Writing to the database failed.";
        field reason: string;
      }

      endpoint getOrder "Order details" {
        description "Fetches an order's details for the details page.";
        http get "/orders/{id}";
        handler detail;
        param id: orderId;
        returns 200 order;
        throws 404 orderMissing;
      }

      endpoint refundOrder "Refund order" {
        description "Requests a refund for a paid order.";
        http post "/orders/{id}/refund";
        handler refund;
        param id: orderId;
        returns 201 refundId;
        throws 404 orderMissing;
        throws 402 payments.paymentError "The gateway declined the refund";
      }

      function detail "get_order()" {
        description "Looks up an order for the details page.";
        async;
        param id: orderId;
        returns order?;
      }

      function refund "refund_order()" {
        description "Asks the gateway for a refund and records the refund number once the gateway confirms.";
        async;
        param id: orderId;
        returns refundId;
        throws payments.paymentError;
      }

      interface store "OrderStore" {
        description "The order storage contract, so CheckoutService doesn't depend on Postgres directly.";

        method save "save()" {
          description "Saves a new order.";
          async;
          param value: order;
          throws dbError;
        }
      }

      class rows "OrderRepository" {
        description "An OrderStore backed by Postgres. Every write uses one transaction per order.";

        method find "find_by_id()" {
          description "Fetches one order with its items.";
          async;
          param id: orderId;
          returns order? "Empty if the order doesn't exist";
        }

        method save "save()" {
          description "Saves a new order in one transaction.";
          async;
          param value: order;
          throws dbError "Writing to the database failed";
        }
      }
    }
  }

  container db "Postgres" { role database; tech postgres; }

  container reports "Nightly Report" {
    description "A legacy script that reads orders straight from the database every night.";
    role service;
    tech php;
  }

  // Relations inside the `shop` block use paths relative to `shop`.
  postCheckout: web.checkout.button -> api.checkout.post { op call; tech https; }
  showDeclined: web.checkout.button -> web.checkout.notice "Show why it was declined" { op call; }

  runCheckout: api.checkout.route -> api.checkout.service.run "Run checkout" {
    op call;
    data push api.orders.cart;
    data pull api.orders.orderId;
  }

  computeTotal: api.checkout.service.run -> api.checkout.service.total "Compute total" {
    op call;
    data pull api.orders.money;
  }

  sumBundle: api.checkout.service.total -> api.checkout.service.total "Sum bundle" { op call; }

  charge: api.checkout.service.run -> api.payments.client.charge "Charge" {
    op call;
    data push api.orders.money;
    data pull api.payments.chargeId;
  }

  saveOrder: api.checkout.service.run -> api.orders.store.save "Save order" {
    op call;
    data push api.orders.order;
  }

  insertOrder: api.orders.rows.save -> db "INSERT orders" { op write; data push api.orders.order; }
  getDetail: web.detail -> api.orders.getOrder { op call; tech https; }

  findOrder: api.orders.detail -> api.orders.rows.find "Find by id" {
    op call;
    data push api.orders.orderId;
    data pull api.orders.order;
  }

  selectOrder: api.orders.rows.find -> db "SELECT orders" { op read; data pull api.orders.order; }
  postRefund: web.detail -> api.orders.refundOrder { op call; tech https; }
  recordRefund: api.orders.refund -> db "UPDATE orders" { op write; data push api.orders.refundId; }
  nightlyReport: reports -> db "SELECT orders" { op read; data pull api.orders.order; }

  // Class structure.
  repoContract: api.orders.rows -> api.orders.store { op implements; }
  serviceStore: api.checkout.service -> api.orders.store { op refers; }
  serviceClient: api.checkout.service -> api.payments.client { op refers; }
}
