dim "0.6";

person customer "Customer";

system shop "Online Shop" {
  container web "Web" { role app; tech astro; }

  container api "API" {
    role service;
    paradigm procedural;
    tech rust;

    component orders "Orders" {
      description "Takes orders from the web app and saves them.";

      record order "Order" {
        description "What the web app sends in an order.";
        field items: string[];
        field address: string;
      }

      alias orderId "OrderId" {
        description "The order number shown on the confirmation screen.";
        type uuid;
      }

      function save "save_order()" {
        description "Writes an order to Postgres in one transaction.";
        param value: order;
        returns orderId;
      }
    }
  }

  container db "Postgres" { role database; tech postgres; }
}

shopping: customer -> shop.web "Shops" { op use; }

placeOrder: shop.web -> shop.api "POST /orders" {
  op call;
  data push shop.api.orders.order;
  data pull shop.api.orders.orderId;
}

saveOrder: shop.api.orders.save -> shop.db "INSERT orders" {
  op write;
  data push shop.api.orders.order;
}
