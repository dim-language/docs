dim "0.6";

person pembeli "Pembeli";

system toko "Toko Online" {
  container web "Web" { role app; tech astro; }

  container api "API" {
    role service;
    paradigm procedural;
    tech rust;

    component pesanan "Pesanan" {
      description "Menerima pesanan dari Web dan menyimpannya.";

      record dataPesanan "Pesanan" {
        description "Isi pesanan yang dikirim Web.";
        field barang: string[];
        field alamat: string;
      }

      alias idPesanan "IdPesanan" {
        description "Nomor pesanan yang tampil di layar konfirmasi.";
        type uuid;
      }

      function simpan "simpan_pesanan()" {
        description "Menulis pesanan ke Postgres dalam satu transaksi.";
        param pesanan: dataPesanan;
        returns idPesanan;
      }
    }
  }

  container db "Postgres" { role database; tech postgres; }
}

belanja: pembeli -> toko.web "Belanja" { op use; }

kirimPesanan: toko.web -> toko.api "POST /pesanan" {
  op call;
  data push toko.api.pesanan.dataPesanan;
  data pull toko.api.pesanan.idPesanan;
}

simpanPesanan: toko.api.pesanan.simpan -> toko.db "INSERT pesanan" {
  op write;
  data push toko.api.pesanan.dataPesanan;
}
