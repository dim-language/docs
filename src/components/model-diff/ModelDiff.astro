---
// Diff dua model dim (model dasar dan turunan `amends`), dihitung dari id elemen dan id relasi
// yang stabil (spesifikasi §11.3). Semua isi tabel berasal dari output parser.
import type { DimElement, DimModel, DimRelation } from '@dim/sdk';

interface Props {
	base: DimModel;
	derived: DimModel;
	caption?: string;
}

const { base, derived, caption } = Astro.props;
const english = Astro.locals.starlightRoute.lang === 'en';
const text = english ? {
	viewport: 'Model comparison table. Scroll horizontally on narrow screens.',
	change: 'Change',
	empty: 'empty',
	ditambah: 'Added',
	dihapus: 'Removed',
	diubah: 'Changed',
	elemen: 'element',
	relasi: 'relation',
	unchanged: (n: number) => n === 1
		? '1 other element or relation is identical in both models.'
		: `${n} other elements and relations are identical in both models.`,
} : {
	viewport: 'Tabel perbedaan model, bisa digeser ke samping di layar sempit',
	change: 'Perubahan',
	empty: 'kosong',
	ditambah: 'ditambah',
	dihapus: 'dihapus',
	diubah: 'diubah',
	elemen: 'elemen',
	relasi: 'relasi',
	unchanged: (n: number) => `${n} elemen dan relasi lain sama persis di kedua model.`,
};

type Row = { change: 'ditambah' | 'dihapus' | 'diubah'; what: 'elemen' | 'relasi'; id: string; detail: string };

const show = (v: unknown) => (v === null || v === undefined ? text.empty : Array.isArray(v) ? v.join(', ') || text.empty : String(v));

// Jenis elemen seperti ditulis di sumber: `container`, `endpoint`, atau bentuk kode (`class`, `record`, ...).
const keyword = (e: DimElement) => (e.kind === 'code' ? e.form : e.kind);

function elementDetail(e: DimElement) {
	const techs = 'techs' in e ? (e.techs ?? []).join(', ') : '';
	return [keyword(e), e.name, techs].filter(Boolean).join(' · ');
}

function relationDetail(r: DimRelation) {
	return [`${r.from} → ${r.to}`, r.op, r.label ?? ''].filter(Boolean).join(' · ');
}

// Field yang berbeda, dari semua field kedua sisi. Field yang tidak berlaku tidak ditulis di JSON (§16), jadi
// field yang hilang di satu sisi berarti ditambah atau dihapus.
function changedFields(a: object, b: object) {
	const x = a as Record<string, unknown>;
	const y = b as Record<string, unknown>;
	const fields = [...new Set([...Object.keys(x), ...Object.keys(y)])].filter((f) => f !== 'id');
	return fields
		.filter((f) => JSON.stringify(x[f]) !== JSON.stringify(y[f]))
		.map((f) => `${f}: ${show(typeof x[f] === 'object' && x[f] !== null && !Array.isArray(x[f]) ? JSON.stringify(x[f]) : x[f])} → ${show(typeof y[f] === 'object' && y[f] !== null && !Array.isArray(y[f]) ? JSON.stringify(y[f]) : y[f])}`);
}

function compare<T extends { id: string }>(what: Row['what'], before: T[], after: T[], detail: (t: T) => string) {
	const old = new Map(before.map((t) => [t.id, t]));
	const now = new Set(after.map((t) => t.id));
	for (const t of after) {
		const was = old.get(t.id);
		if (!was) rows.push({ change: 'ditambah', what, id: t.id, detail: detail(t) });
		else {
			const diff = changedFields(was, t);
			if (diff.length) rows.push({ change: 'diubah', what, id: t.id, detail: diff.join('; ') });
		}
	}
	for (const t of before) {
		if (!now.has(t.id)) rows.push({ change: 'dihapus', what, id: t.id, detail: detail(t) });
	}
}

const rows: Row[] = [];
compare('elemen', base.elements, derived.elements, elementDetail);
compare('relasi', base.relations, derived.relations, relationDetail);

const order = { dihapus: 0, diubah: 1, ditambah: 2 };
rows.sort((a, b) => order[a.change] - order[b.change] || a.what.localeCompare(b.what));
const unchanged = derived.elements.length + derived.relations.length - rows.filter((r) => r.change !== 'dihapus').length;
---

<figure class="model-diff not-content">
	<div class="md-scroll" tabindex="0" aria-label={text.viewport}>
		<table>
			<thead>
				<tr>
					<th scope="col">{text.change}</th>
					<th scope="col">Id</th>
					<th scope="col">Detail</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((r) => (
						<tr data-change={r.change}>
							<td>
								{text[r.change]} {text[r.what]}
							</td>
							<td>
								<code>{r.id}</code>
							</td>
							<td>{r.detail}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
	<figcaption>
		{caption}
		{caption && ' '}
		{text.unchanged(unchanged)}
	</figcaption>
</figure>

<style>
	.model-diff {
		margin: 1.5rem 0;
	}

	.md-scroll {
		overflow-x: auto;
	}

	.md-scroll:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}

	th,
	td {
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		text-align: start;
		vertical-align: top;
	}

	th {
		color: var(--sl-color-white);
		font-weight: 600;
		border-bottom-width: 1.5px;
		border-bottom-color: var(--sl-color-gray-3);
	}

	td:first-child {
		white-space: nowrap;
		font-weight: 600;
		color: var(--sl-color-white);
	}

	/* Yang dihapus dicoret, seperti jalan yang ditutup di revisi peta. */
	tr[data-change='dihapus'] td:nth-child(2) code {
		text-decoration: line-through;
	}

	td code {
		white-space: nowrap;
	}

	figcaption {
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
