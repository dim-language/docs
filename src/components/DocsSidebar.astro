---
import { Icon } from '@astrojs/starlight/components';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';

const { sidebar, lang } = Astro.locals.starlightRoute;
const icons = ['information', 'rocket', 'open-book', 'list-format'] as const;
type Entry = (typeof sidebar)[number];
function isCurrent(entry: Entry): boolean {
	return entry.type === 'link' ? entry.isCurrent : entry.entries.some(isCurrent);
}
const sections = sidebar.filter(entry => entry.type === 'group');
const current = sections.find(isCurrent);
---
<nav class="sections" aria-label={lang === 'en' ? 'Documentation sections' : 'Bagian dokumentasi'}>
	{sections.map((section, index) => {
		const first = section.entries[0];
		return first?.type === 'link' && (
			<a href={first.href} aria-current={section === current ? 'location' : undefined}>
				<Icon name={icons[index]} size="1rem" />{section.label}
			</a>
		);
	})}
</nav>
{current && <SidebarSublist sublist={current.entries} />}
<div class="md:sl-hidden"><MobileMenuFooter /></div>

<style>
	.sections {
		display: grid;
		gap: .15rem;
		padding: .35rem;
		margin-bottom: 1.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: .5rem;
	}
	.sections a {
		display: flex;
		align-items: center;
		gap: .7rem;
		padding: .45rem .65rem;
		border-radius: .25rem;
		text-decoration: none;
		color: var(--sl-color-gray-2);
	}
	.sections a:hover, .sections a[aria-current] {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}
	.sections a[aria-current] { font-weight: 600; }
	.sections a[aria-current] svg { color: var(--sl-color-accent-high); }
</style>
