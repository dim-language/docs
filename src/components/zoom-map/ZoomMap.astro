---
// Peta zoom interaktif. Data berasal dari output parser dim (`dim parse`), bukan ditulis tangan.
// Komponennya (markup, kamera, tab, kontrol, CSS) ada di `@dim/sdk/map`; file ini hanya memilih bahasa,
// mengisi token warna dari tema Starlight, dan membungkusnya dengan figure.
import { initDim, type DimModel } from '@dim/sdk';
import { renderMapHtml } from '@dim/sdk/map';
import '@dim/sdk/map.css';

interface Props {
	model: DimModel;
	/** Elemen yang ditampilkan dekat pada contoh level kode. */
	focus?: string;
	/** Id unik kalau ada lebih dari satu peta di halaman. */
	uid?: string;
	/** Id flow yang langsung disorot. */
	flow?: string;
	caption?: string;
}

const { model, focus, uid = 'zm', flow = null, caption } = Astro.props;
const language = Astro.locals.starlightRoute.lang === 'en' ? 'en' : 'id';
await initDim();
const html = renderMapHtml(model, { uid, language, flow, focus });
---

<figure class="zoom-map not-content">
	<Fragment set:html={html} />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	import { mountAll } from '@dim/sdk/map';

	mountAll().catch((error) => console.error('Could not initialize DIM map', error));
</script>

<style>
	/* Token peta (`@dim/sdk/map.css`) diisi dari tema Starlight docs. */
	.zoom-map {
		--zm-ink: var(--sl-color-white);
		--zm-text: var(--sl-color-gray-2);
		--zm-muted: var(--sl-color-gray-3);
		--zm-paper: var(--sl-color-black);
		--zm-rule: var(--sl-color-gray-5);
		--zm-hover: var(--sl-color-gray-6);
		--zm-accent: var(--sl-color-accent);
		--zm-route: var(--dim-route);
		--zm-edge: var(--dim-edge);
		--zm-place-bg: var(--dim-place-bg);
		--zm-place-border: var(--dim-place-border);
		--zm-region-border: var(--dim-region-border);
		--zm-font-mono: var(--sl-font-mono);
		--zm-text-xs: var(--sl-text-xs);
		--zm-text-sm: var(--sl-text-sm);

		margin: 2rem 0;
	}

	.zoom-map figcaption {
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
