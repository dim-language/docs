---
interface Props {
	scene: 'order-id' | 'review' | 'your-turn' | 'missing-direction';
}
---
<aside class="brian-note">
	<img src={`/brian/${Astro.props.scene}.webp`} alt="" loading="lazy" />
	<div><strong>Brian</strong><p><slot /></p></div>
</aside>
<style>
	.brian-note {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: .75rem 1rem;
		border-inline-start: .2rem solid var(--sl-color-accent);
		background: var(--sl-color-gray-6);
	}
	.brian-note img { width: clamp(4rem, 18%, 8rem); height: 5.5rem; object-fit: contain; }
	.brian-note p, .brian-note div { margin: 0; }
</style>
